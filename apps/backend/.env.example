# Copy to .env (gitignored) and fill in a FRESH key. Never commit real keys.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://aivillage:aivillage@localhost:5433/aivillage

# v3 world clock: village tick cadence + LLM-cost throttle
WORLD_TICK_SECONDS=60
WORLD_MAX_ACTORS_PER_TICK=2
